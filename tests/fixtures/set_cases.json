{
  "about": [
    "POST /gameday/set requests and the settings they leave in /gameday/state.",
    "Checked against the firmware's parser (components/gameday/set_request.h) by test_set.cpp",
    "and against tests/web/mock_device.py by its --selftest, so the page's mock can't drift.",
    "Each case starts from base plus its own start, sends set (key, value pairs, applied in",
    "kSetKeys order) and compares the keys in expect. Teams are written league:id, \"\" for none.",
    "status 400: no key in the request is one the firmware takes, so nothing changes.",
    "The panel keeps the saved team's league byte after the team is cleared, and a fresh panel's",
    "is NFL, so Live auto counts that league too (team_league in start sets it).",
    "follow is the Follow this game pin, kept in memory only. board (start only) says the mode",
    "has a game of its own on the panel to follow: not Live games' fallback card or finals, nor",
    "an empty board, and final (start only) that its game has ended. A new team or mode, any",
    "favorites post or new leagues let the pin go.",
    "idle is the idle display (0 next game, 1 clock, 2 scores, 3 my team today, 4 off or dim),",
    "idledim its dim level (0 dark), night the night hours with nightstart and nightend (HH:MM,",
    "24-hour) and nightbri their brightness."
  ],
  "base": {
    "team": "nfl:6", "team_league": "nfl", "mode": 0, "rotate": 1, "lockon": 15, "release": 30, "collide": 0,
    "favs": ["", "", "", ""], "today": false, "live": [], "live_auto": true, "tz": 1, "tz_auto": true,
    "down": true, "count": true, "match": true, "play": true, "odds": true, "opp": true, "bootaddr": true,
    "autoupd": false, "beta": false, "panels": 1, "follow": false, "board": true, "final": false,
    "alerts": 524287, "alertfav": false, "standing": 0,
    "idle": 0, "idledim": 0, "night": false, "nightstart": "22:00", "nightend": "07:00", "nightbri": 20
  },
  "cases": [
    {"name": "mode 5 is Live games", "set": [["mode", "5"]], "expect": {"mode": 5}},
    {"name": "mode past Live games is refused", "set": [["mode", "6"]], "expect": {"mode": 0}},
    {"name": "negative mode is refused", "start": {"mode": 4}, "set": [["mode", "-1"]], "expect": {"mode": 4}},
    {"name": "mode reads like atoi, so text is My team", "start": {"mode": 4}, "set": [["mode", "abc"]], "expect": {"mode": 0}},
    {"name": "a mode past int's range is refused, not wrapped to My team", "start": {"mode": 4}, "set": [["mode", "4294967296"]], "expect": {"mode": 4}},
    {"name": "a mode in other digits reads as text, so My team", "start": {"mode": 4}, "set": [["mode", "\u0665"]], "expect": {"mode": 0}},

    {"name": "rotate in range", "set": [["rotate", "15"]], "expect": {"rotate": 15}},
    {"name": "rotate below 1 clamps up", "start": {"rotate": 10}, "set": [["rotate", "0"]], "expect": {"rotate": 1}},
    {"name": "rotate above 30 clamps down", "set": [["rotate", "31"]], "expect": {"rotate": 30}},
    {"name": "empty rotate is the minimum", "start": {"rotate": 10}, "set": [["rotate", ""]], "expect": {"rotate": 1}},
    {"name": "rotate past int's range clamps down, not around", "set": [["rotate", "99999999999999999999"]], "expect": {"rotate": 30}},

    {"name": "lockon in range", "set": [["lockon", "60"]], "expect": {"lockon": 60}},
    {"name": "lockon below 5 clamps up", "set": [["lockon", "4"]], "expect": {"lockon": 5}},
    {"name": "lockon above 120 clamps down", "set": [["lockon", "121"]], "expect": {"lockon": 120}},
    {"name": "lockon past int's range clamps down, not around", "set": [["lockon", "4294967300"]], "expect": {"lockon": 120}},

    {"name": "release in range", "set": [["release", "600"]], "expect": {"release": 600}},
    {"name": "release below 30 clamps up", "start": {"release": 600}, "set": [["release", "29"]], "expect": {"release": 30}},
    {"name": "release above 3600 clamps down", "set": [["release", "3601"]], "expect": {"release": 3600}},

    {"name": "collide on", "set": [["collide", "1"]], "expect": {"collide": 1}},
    {"name": "switches are on for 1 only", "start": {"collide": 1, "today": true}, "set": [["collide", "true"], ["today", "yes"]], "expect": {"collide": 0, "today": false}},
    {"name": "today on", "set": [["today", "1"]], "expect": {"today": true}},
    {"name": "ticker and boot switches off", "set": [["down", "0"], ["play", "0"], ["odds", "0"], ["opp", "0"], ["bootaddr", "0"], ["tzauto", "0"]],
     "expect": {"down": false, "play": false, "odds": false, "opp": false, "bootaddr": false, "tz_auto": false}},
    {"name": "each sport's situation switch is its own", "set": [["count", "0"]], "expect": {"down": true, "count": false, "match": true}},
    {"name": "soccer stats off, football and baseball stay on", "set": [["match", "0"]], "expect": {"down": true, "count": true, "match": false}},
    {"name": "football off leaves the others", "set": [["down", "0"]], "expect": {"down": false, "count": true, "match": true}},
    {"name": "automatic updates on", "set": [["autoupd", "1"]], "expect": {"autoupd": true}},
    {"name": "follow beta on", "set": [["beta", "1"]], "expect": {"beta": true, "autoupd": false}},
    {"name": "follow beta off", "start": {"beta": true}, "set": [["beta", "0"]], "expect": {"beta": false}},

    {"name": "tz by index", "set": [["tz", "3"]], "expect": {"tz": 3}},
    {"name": "tz by name", "set": [["tz", "US Eastern"]], "expect": {"tz": 0}},
    {"name": "tz by IANA zone", "set": [["tz", "America/Denver"]], "expect": {"tz": 2}},
    {"name": "tz index past the list is refused", "set": [["tz", "999"]], "expect": {"tz": 1}},
    {"name": "unknown tz is refused", "set": [["tz", "Mars/Olympus"]], "expect": {"tz": 1}},
    {"name": "empty tz is refused", "set": [["tz", ""]], "expect": {"tz": 1}},
    {"name": "a zone index in other digits is refused", "set": [["tz", "\u0663"]], "expect": {"tz": 1}},

    {"name": "team in another league", "set": [["team", "mlb:15"]], "expect": {"team": "mlb:15"}},
    {"name": "team none clears it", "set": [["team", "none"]], "expect": {"team": ""}},
    {"name": "unknown team id is refused", "set": [["team", "nfl:99999"]], "expect": {"team": "nfl:6"}},
    {"name": "unknown league is refused", "set": [["team", "xfl:6"]], "expect": {"team": "nfl:6"}},
    {"name": "team id 0 is refused", "set": [["team", "nfl:0"]], "expect": {"team": "nfl:6"}},
    {"name": "a team id past 32 bits is refused, not wrapped to another team", "start": {"team": "mlb:15", "team_league": "mlb"}, "set": [["team", "nfl:4294967302"]], "expect": {"team": "mlb:15"}},
    {"name": "a team id with a plus sign is read as the number", "start": {"team": "mlb:15", "team_league": "mlb"}, "set": [["team", "nfl:+6"]], "expect": {"team": "nfl:6"}},
    {"name": "a team id with a minus sign is refused", "start": {"team": "mlb:15", "team_league": "mlb"}, "set": [["team", "nfl:-6"]], "expect": {"team": "mlb:15"}},
    {"name": "a team id in other digits is refused", "start": {"team": "mlb:15", "team_league": "mlb"}, "set": [["team", "nfl:\u0666"]], "expect": {"team": "mlb:15"}},
    {"name": "empty team is refused", "set": [["team", ""]], "expect": {"team": "nfl:6"}},
    {"name": "a golf tour can be the team", "set": [["team", "pga:1106"]], "expect": {"team": "pga:1106"}},
    {"name": "a racing series can be the team", "set": [["team", "f1:2030"]], "expect": {"team": "f1:2030"}},

    {"name": "fav slot 1", "set": [["fav1", "mlb:15"]], "expect": {"favs": ["mlb:15", "", "", ""]}},
    {"name": "fav slot 4", "set": [["fav4", "nhl:25"]], "expect": {"favs": ["", "", "", "nhl:25"]}},
    {"name": "fav slot none clears it", "start": {"favs": ["mlb:15", "nfl:6", "", ""]}, "set": [["fav2", "none"]], "expect": {"favs": ["mlb:15", "", "", ""]}},
    {"name": "empty fav slot clears it", "start": {"favs": ["mlb:15", "nfl:6", "nhl:25", ""]}, "set": [["fav3", ""]], "expect": {"favs": ["mlb:15", "nfl:6", "", ""]}},
    {"name": "a fav team id with a plus sign is read as the number", "start": {"favs": ["mlb:15", "", "", ""]}, "set": [["fav2", "nfl:+6"]], "expect": {"favs": ["mlb:15", "nfl:6", "", ""]}},
    {"name": "unknown fav team is refused", "start": {"favs": ["mlb:15", "nfl:6", "", ""]}, "set": [["fav2", "nfl:99999"]], "expect": {"favs": ["mlb:15", "nfl:6", "", ""]}},
    {"name": "garbage fav is refused", "start": {"favs": ["mlb:15", "nfl:6", "", ""]}, "set": [["fav2", "cowboys"]], "expect": {"favs": ["mlb:15", "nfl:6", "", ""]}},
    {"name": "a golf tour isn't a favorite", "set": [["favs", "pga:1106,nfl:6"]], "expect": {"favs": ["nfl:6", "", "", ""]}},
    {"name": "fav1 refuses a golf tour", "start": {"favs": ["nfl:6", "", "", ""]}, "set": [["fav1", "lpga:1107"]], "expect": {"favs": ["nfl:6", "", "", ""]}},
    {"name": "a racing series isn't a favorite", "set": [["favs", "nascar:2021,nfl:6"]], "expect": {"favs": ["nfl:6", "", "", ""]}},
    {"name": "fav2 refuses a racing series", "start": {"favs": ["nfl:6", "", "", ""]}, "set": [["fav2", "f1:2030"]], "expect": {"favs": ["nfl:6", "", "", ""]}},
    {"name": "fav slot 5 is not a key", "set": [["fav5", "mlb:15"]], "status": 400, "expect": {"favs": ["", "", "", ""]}},
    {"name": "fav slot 0 is not a key", "set": [["fav0", "mlb:15"]], "status": 400, "expect": {"favs": ["", "", "", ""]}},

    {"name": "favs list keeps order, drops repeats and unknowns",
     "set": [["favs", "mlb:15,nfl:6,mlb:15,bogus,nfl:99999,nhl:25"]], "expect": {"favs": ["mlb:15", "nfl:6", "nhl:25", ""]}},
    {"name": "empty favs clears the list", "start": {"favs": ["mlb:15", "nfl:6", "", "", "nhl:25"]}, "set": [["favs", ""]], "expect": {"favs": ["", "", "", ""]}},
    {"name": "favs past four show in full", "set": [["favs", "nfl:1,nfl:2,nfl:3,nfl:4,nfl:5,nfl:6"]],
     "expect": {"favs": ["nfl:1", "nfl:2", "nfl:3", "nfl:4", "nfl:5", "nfl:6"]}},
    {"name": "favs stop at sixteen",
     "set": [["favs", "nfl:1,nfl:2,nfl:3,nfl:4,nfl:5,nfl:6,nfl:7,nfl:8,nfl:9,nfl:10,nfl:11,nfl:12,nfl:13,nfl:14,nfl:15,nfl:16,nfl:17"]],
     "expect": {"favs": ["nfl:1", "nfl:2", "nfl:3", "nfl:4", "nfl:5", "nfl:6", "nfl:7", "nfl:8", "nfl:9", "nfl:10", "nfl:11", "nfl:12", "nfl:13", "nfl:14", "nfl:15", "nfl:16"]}},
    {"name": "favs applies after a fav slot in the same request", "set": [["favs", "nhl:25"], ["fav1", "mlb:15"]], "expect": {"favs": ["nhl:25", "", "", ""]}},

    {"name": "live list", "set": [["live", "mlb,nhl"]], "expect": {"live": ["mlb", "nhl"], "live_auto": false}},
    {"name": "live list comes back in league order", "set": [["live", "nhl,epl,mlb"]], "expect": {"live": ["mlb", "epl", "nhl"], "live_auto": false}},
    {"name": "live list skips unknown keys", "set": [["live", "nhl,xfl"]], "expect": {"live": ["nhl"], "live_auto": false}},
    {"name": "empty live puts auto back", "start": {"live": ["mlb"], "live_auto": false}, "set": [["live", ""]], "expect": {"live": ["nfl"], "live_auto": true}},
    {"name": "live of only unknown keys is auto", "start": {"live": ["mlb"], "live_auto": false}, "set": [["live", "MLB"]], "expect": {"live": ["nfl"], "live_auto": true}},

    {"name": "auto with no team and no favorites is NFL", "start": {"team": "", "team_league": "nfl"}, "set": [["live", ""]], "expect": {"live": ["nfl"], "live_auto": true}},
    {"name": "auto with the team only", "start": {"team": "mlb:15", "team_league": "mlb"}, "set": [["live", ""]], "expect": {"live": ["mlb"], "live_auto": true}},
    {"name": "auto adds favorites in other leagues", "start": {"favs": ["mlb:15", "nhl:25", "epl:359", ""]}, "set": [["live", ""]],
     "expect": {"live": ["nfl", "mlb", "epl", "nhl"], "live_auto": true}},
    {"name": "auto counts favorites past the fourth", "start": {"favs": ["nfl:1", "", "", "", "mcbb:2000"]}, "set": [["live", ""]], "expect": {"live": ["nfl", "mcbb"], "live_auto": true}},
    {"name": "auto follows a favorites change", "set": [["favs", "nhl:25"]], "expect": {"live": ["nfl", "nhl"], "live_auto": true}},
    {"name": "an explicit list ignores the team and favorites", "start": {"favs": ["mlb:15", "", "", ""]}, "set": [["live", "nhl"]], "expect": {"live": ["nhl"], "live_auto": false}},
    {"name": "a cleared team's league stays in auto", "start": {"team": "mlb:15", "team_league": "mlb", "favs": ["nhl:25", "", "", ""]}, "set": [["team", "none"]],
     "expect": {"team": "", "live": ["mlb", "nhl"], "live_auto": true}},
    {"name": "a fresh panel's NFL counts with no team", "start": {"team": "", "team_league": "nfl", "favs": ["mlb:15", "", "", ""]}, "set": [["live", ""]],
     "expect": {"live": ["nfl", "mlb"], "live_auto": true}},
    {"name": "live leaves golf out", "set": [["live", "pga,mlb"]], "expect": {"live": ["mlb"], "live_auto": false}},
    {"name": "live of only golf is automatic", "start": {"live": ["mlb"], "live_auto": false}, "set": [["live", "pga"]], "expect": {"live": ["nfl"], "live_auto": true}},
    {"name": "auto leaves a golf team's league out", "start": {"team": "pga:1106", "team_league": "pga"}, "set": [["live", ""]], "expect": {"live": ["nfl"], "live_auto": true}},
    {"name": "auto leaves golf out beside a favorite", "start": {"team": "pga:1106", "team_league": "pga", "favs": ["mlb:15", "", "", ""]}, "set": [["live", ""]],
     "expect": {"live": ["mlb"], "live_auto": true}},
    {"name": "live leaves racing out", "set": [["live", "f1,nascar,nhl"]], "expect": {"live": ["nhl"], "live_auto": false}},
    {"name": "auto leaves a racing team's league out", "start": {"team": "f1:2030", "team_league": "f1"}, "set": [["live", ""]], "expect": {"live": ["nfl"], "live_auto": true}},

    {"name": "two panels", "set": [["panels", "2"]], "expect": {"panels": 2}},
    {"name": "zero panels is refused", "start": {"panels": 2}, "set": [["panels", "0"]], "expect": {"panels": 2}},
    {"name": "more panels than the build drives is refused", "set": [["panels", "3"]], "expect": {"panels": 1}},
    {"name": "a panel count past a byte is refused, not wrapped to one panel", "start": {"panels": 2}, "set": [["panels", "257"]], "expect": {"panels": 2}},
    {"name": "a negative panel count is refused, not wrapped to two panels", "set": [["panels", "-254"]], "expect": {"panels": 1}},

    {"name": "follow pins the game in Live games", "start": {"mode": 5}, "set": [["follow", "1"]], "expect": {"follow": true}},
    {"name": "follow pins the game in an old live mode", "start": {"mode": 3}, "set": [["follow", "1"]], "expect": {"follow": true}},
    {"name": "follow pins a favorite's game in Favorite teams", "start": {"mode": 4, "favs": ["nfl:6", "", "", ""]}, "set": [["follow", "1"]], "expect": {"follow": true}},
    {"name": "follow in My team is ignored", "set": [["follow", "1"]], "expect": {"follow": false, "mode": 0}},
    {"name": "follow in Favorite teams with no favorites is ignored", "start": {"mode": 4}, "set": [["follow", "1"]], "expect": {"follow": false}},
    {"name": "follow with nothing of the mode's own on the board is ignored", "start": {"mode": 5, "board": false}, "set": [["follow", "1"]], "expect": {"follow": false}},
    {"name": "follow on a game that has ended is ignored", "start": {"mode": 5, "final": true}, "set": [["follow", "1"]], "expect": {"follow": false}},
    {"name": "follow on a favorite's last final is ignored", "start": {"mode": 4, "favs": ["nfl:6", "", "", ""], "final": true}, "set": [["follow", "1"]], "expect": {"follow": false}},
    {"name": "follow 1 again on the final it follows keeps the pin", "start": {"mode": 5, "follow": true, "final": true}, "set": [["follow", "1"]], "expect": {"follow": true}},
    {"name": "an ignored follow doesn't stop the rest", "set": [["follow", "1"], ["rotate", "5"]], "expect": {"follow": false, "rotate": 5}},
    {"name": "follow 0 lets go", "start": {"mode": 5, "follow": true}, "set": [["follow", "0"]], "expect": {"follow": false}},
    {"name": "follow is on for 1 only, like the switches", "start": {"mode": 5, "follow": true}, "set": [["follow", "on"]], "expect": {"follow": false}},
    {"name": "follow 1 again keeps the pin", "start": {"mode": 5, "follow": true}, "set": [["follow", "1"]], "expect": {"follow": true}},
    {"name": "another mode lets the pin go", "start": {"mode": 5, "follow": true}, "set": [["mode", "4"]], "expect": {"follow": false}},
    {"name": "the same mode keeps the pin", "start": {"mode": 5, "follow": true}, "set": [["mode", "5"]], "expect": {"follow": true}},
    {"name": "a refused mode keeps the pin", "start": {"mode": 5, "follow": true}, "set": [["mode", "9"]], "expect": {"follow": true, "mode": 5}},
    {"name": "another team lets the pin go", "start": {"mode": 5, "follow": true}, "set": [["team", "mlb:15"]], "expect": {"follow": false}},
    {"name": "clearing the team lets the pin go", "start": {"mode": 5, "follow": true}, "set": [["team", "none"]], "expect": {"follow": false}},
    {"name": "the same team keeps the pin", "start": {"mode": 5, "follow": true}, "set": [["team", "nfl:6"]], "expect": {"follow": true}},
    {"name": "a favorites post lets the pin go", "start": {"mode": 4, "favs": ["nfl:6", "", "", ""], "follow": true}, "set": [["favs", "nfl:6,mlb:15"]], "expect": {"follow": false}},
    {"name": "a favorite slot lets the pin go in Live games too", "start": {"mode": 5, "follow": true}, "set": [["fav2", "mlb:15"]], "expect": {"follow": false}},
    {"name": "a refused favorite slot keeps the pin", "start": {"mode": 5, "follow": true}, "set": [["fav2", "nfl:99999"]], "expect": {"follow": true}},
    {"name": "new leagues let the pin go", "start": {"mode": 5, "follow": true}, "set": [["live", "mlb"]], "expect": {"follow": false}},
    {"name": "the same leagues keep the pin", "start": {"mode": 5, "follow": true}, "set": [["live", ""]], "expect": {"follow": true}},
    {"name": "other settings keep the pin", "start": {"mode": 5, "follow": true}, "set": [["rotate", "10"], ["today", "1"], ["release", "60"]], "expect": {"follow": true, "rotate": 10}},
    {"name": "follow applies first, so a mode change in the same request lets it go", "start": {"mode": 5}, "set": [["mode", "4"], ["follow", "1"]], "expect": {"follow": false, "mode": 4}},
    {"name": "alerts sets which big plays splash", "set": [["alerts", "5"]], "expect": {"alerts": 5}},
    {"name": "alerts 0 turns every big play off", "set": [["alerts", "0"]], "expect": {"alerts": 0}},
    {"name": "alerts back on", "start": {"alerts": 0}, "set": [["alerts", "524287"]], "expect": {"alerts": 524287}},
    {"name": "an alert past the known ones is refused", "start": {"alerts": 7}, "set": [["alerts", "524288"]], "expect": {"alerts": 7}},
    {"name": "negative alerts are refused", "start": {"alerts": 7}, "set": [["alerts", "-1"]], "expect": {"alerts": 7}},
    {"name": "alerts past int's range are refused", "start": {"alerts": 7}, "set": [["alerts", "99999999999"]], "expect": {"alerts": 7}},
    {"name": "alerts with no number are refused, not read as every switch off", "start": {"alerts": 7}, "set": [["alerts", "abc"]], "expect": {"alerts": 7}},
    {"name": "empty alerts are refused too", "start": {"alerts": 7}, "set": [["alerts", ""]], "expect": {"alerts": 7}},
    {"name": "alerts after spaces read like atoi", "set": [["alerts", " 12x"]], "expect": {"alerts": 12}},
    {"name": "favorite teams only on", "set": [["alertfav", "1"]], "expect": {"alertfav": true}},
    {"name": "favorite teams only off", "start": {"alertfav": true}, "set": [["alertfav", "0"]], "expect": {"alertfav": false}},
    {"name": "alerts and favorite teams only in one request", "set": [["alertfav", "1"], ["alerts", "3"]], "expect": {"alerts": 3, "alertfav": true}},
    {"name": "standing next to pro teams: seed", "set": [["standing", "1"]], "expect": {"standing": 1}},
    {"name": "standing next to pro teams: place", "set": [["standing", "2"]], "expect": {"standing": 2}},
    {"name": "standing back to the record", "start": {"standing": 2}, "set": [["standing", "0"]], "expect": {"standing": 0}},
    {"name": "a standing past place is refused", "start": {"standing": 1}, "set": [["standing", "3"]], "expect": {"standing": 1}},
    {"name": "a negative standing is refused", "start": {"standing": 2}, "set": [["standing", "-1"]], "expect": {"standing": 2}},
    {"name": "a standing reads like atoi, so text is the record", "start": {"standing": 2}, "set": [["standing", "seed"]], "expect": {"standing": 0}},
    {"name": "a standing past int's range is refused, not wrapped to the record", "start": {"standing": 1}, "set": [["standing", "4294967296"]], "expect": {"standing": 1}},
    {"name": "the standing leaves the ticker switches alone", "set": [["standing", "2"], ["count", "0"]], "expect": {"standing": 2, "count": false, "down": true}},

    {"name": "no known key answers 400", "start": {"rotate": 5}, "set": [["bogus", "1"]], "status": 400, "expect": {"rotate": 5}},
    {"name": "unknown keys next to known ones are skipped", "set": [["bogus", "1"], ["rotate", "5"]], "expect": {"rotate": 5}},
    {"name": "one refused key doesn't stop the rest", "set": [["mode", "9"], ["rotate", "5"], ["tz", "Mars"]], "expect": {"mode": 0, "rotate": 5, "tz": 1}},

    {"name": "idle display: the scores", "set": [["idle", "2"]], "expect": {"idle": 2}},
    {"name": "idle display: off or dim", "set": [["idle", "4"]], "expect": {"idle": 4}},
    {"name": "idle past the choices is refused", "start": {"idle": 1}, "set": [["idle", "5"]], "expect": {"idle": 1}},
    {"name": "a negative idle is refused", "start": {"idle": 3}, "set": [["idle", "-1"]], "expect": {"idle": 3}},
    {"name": "idle reads like atoi", "set": [["idle", "3x"]], "expect": {"idle": 3}},
    {"name": "idle as text is the next game", "start": {"idle": 2}, "set": [["idle", "clock"]], "expect": {"idle": 0}},
    {"name": "dim level in range", "set": [["idledim", "40"]], "expect": {"idledim": 40}},
    {"name": "dim level 0 is dark", "start": {"idledim": 40}, "set": [["idledim", "0"]], "expect": {"idledim": 0}},
    {"name": "dim level above 255 clamps down", "set": [["idledim", "999"]], "expect": {"idledim": 255}},
    {"name": "a negative dim level clamps up", "start": {"idledim": 40}, "set": [["idledim", "-5"]], "expect": {"idledim": 0}},
    {"name": "night hours on", "set": [["night", "1"]], "expect": {"night": true}},
    {"name": "night hours are on for 1 only", "start": {"night": true}, "set": [["night", "on"]], "expect": {"night": false}},
    {"name": "night start and end", "set": [["nightstart", "23:30"], ["nightend", "06:15"]], "expect": {"nightstart": "23:30", "nightend": "06:15"}},
    {"name": "a night time with one hour digit", "set": [["nightend", "6:00"]], "expect": {"nightend": "06:00"}},
    {"name": "a night time in minutes is refused", "set": [["nightstart", "1350"]], "expect": {"nightstart": "22:00"}},
    {"name": "a night time past the day is refused", "set": [["nightend", "24:00"]], "expect": {"nightend": "07:00"}},
    {"name": "a 12-hour night time is refused", "set": [["nightstart", "11:30 PM"]], "expect": {"nightstart": "22:00"}},
    {"name": "an empty night time is refused", "set": [["nightend", ""]], "expect": {"nightend": "07:00"}},
    {"name": "night brightness in range", "set": [["nightbri", "35"]], "expect": {"nightbri": 35}},
    {"name": "night brightness never goes dark", "set": [["nightbri", "0"]], "expect": {"nightbri": 1}},
    {"name": "night brightness above 255 clamps down", "set": [["nightbri", "400"]], "expect": {"nightbri": 255}},
    {"name": "the idle display and night hours in one request", "set": [["nightbri", "12"], ["night", "1"], ["idledim", "8"], ["idle", "4"]], "expect": {"idle": 4, "idledim": 8, "night": true, "nightbri": 12}},
    {"name": "the idle display keeps the follow pin", "start": {"mode": 5, "follow": true}, "set": [["idle", "1"], ["night", "1"]], "expect": {"follow": true, "idle": 1, "night": true}}
  ]
}
