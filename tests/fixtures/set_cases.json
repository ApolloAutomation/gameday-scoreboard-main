    {"name": "follow pins the game in an old live mode", "start": {"mode": 3}, "set": [["follow", "1"]], "expect": {"follow": true}},
    {"name": "follow pins a favorite's game in Favorite teams", "start": {"mode": 4, "favs": ["nfl:6", "", "", ""]}, "set": [["follow", "1"]], "expect": {"follow": true}},
    {"name": "follow in My team is ignored", "set": [["follow", "1"]], "expect": {"follow": false, "mode": 0}},
    {"name": "follow in Favorite teams with no favorites is ignored", "start": {"mode": 4}, "set": [["follow", "1"]], "expect": {"follow": false}},
