    {"name": "playerdel then player in one request puts the new one in the freed slot", "start": {"players": [{"l": "nfl", "id": 3918298, "team": 2, "name": "ALLEN"}, {"l": "nfl", "id": 15847, "team": 12, "name": "KELCE"}, {"l": "nba", "id": 4594268, "team": 16, "name": "EDWARDS"}]}, "set": [["player", "nfl,3139477,12,MAHOMES"], ["playerdel", "nfl,15847"]], "expect": {"players": [{"l": "nfl", "id": 3918298, "team": 2, "name": "ALLEN"}, {"l": "nfl", "id": 3139477, "team": 12, "name": "MAHOMES"}, {"l": "nba", "id": 4594268, "team": 16, "name": "EDWARDS"}]}},
    {"name": "a ninth player changes nothing", "start": {"players": [{"l": "nfl", "id": 1001, "team": 2, "name": "P1"}, {"l": "nfl", "id": 1002, "team": 2, "name": "P2"}, {"l": "nfl", "id": 1003, "team": 2, "name": "P3"}, {"l": "nfl", "id": 1004, "team": 2, "name": "P4"}, {"l": "nfl", "id": 1005, "team": 2, "name": "P5"}, {"l": "nfl", "id": 1006, "team": 2, "name": "P6"}, {"l": "nfl", "id": 1007, "team": 2, "name": "P7"}, {"l": "nfl", "id": 1008, "team": 2, "name": "P8"}]}, "set": [["player", "nfl,3918298,2,ALLEN"]], "expect": {"players": [{"l": "nfl", "id": 1001, "team": 2, "name": "P1"}, {"l": "nfl", "id": 1002, "team": 2, "name": "P2"}, {"l": "nfl", "id": 1003, "team": 2, "name": "P3"}, {"l": "nfl", "id": 1004, "team": 2, "name": "P4"}, {"l": "nfl", "id": 1005, "team": 2, "name": "P5"}, {"l": "nfl", "id": 1006, "team": 2, "name": "P6"}, {"l": "nfl", "id": 1007, "team": 2, "name": "P7"}, {"l": "nfl", "id": 1008, "team": 2, "name": "P8"}]}},
    {"name": "a full list still takes a new name for a player in it", "start": {"players": [{"l": "nfl", "id": 1001, "team": 2, "name": "P1"}, {"l": "nfl", "id": 1002, "team": 2, "name": "P2"}, {"l": "nfl", "id": 1003, "team": 2, "name": "P3"}, {"l": "nfl", "id": 1004, "team": 2, "name": "P4"}, {"l": "nfl", "id": 1005, "team": 2, "name": "P5"}, {"l": "nfl", "id": 1006, "team": 2, "name": "P6"}, {"l": "nfl", "id": 1007, "team": 2, "name": "P7"}, {"l": "nfl", "id": 1008, "team": 2, "name": "P8"}]}, "set": [["player", "nfl,1001,2,NEW"]], "expect": {"players": [{"l": "nfl", "id": 1001, "team": 2, "name": "NEW"}, {"l": "nfl", "id": 1002, "team": 2, "name": "P2"}, {"l": "nfl", "id": 1003, "team": 2, "name": "P3"}, {"l": "nfl", "id": 1004, "team": 2, "name": "P4"}, {"l": "nfl", "id": 1005, "team": 2, "name": "P5"}, {"l": "nfl", "id": 1006, "team": 2, "name": "P6"}, {"l": "nfl", "id": 1007, "team": 2, "name": "P7"}, {"l": "nfl", "id": 1008, "team": 2, "name": "P8"}]}},
    {"name": "a favorite player changes no other setting", "start": {"mode": 5, "follow": true}, "set": [["player", "nfl,3918298,2,ALLEN"]], "expect": {"players": [{"l": "nfl", "id": 3918298, "team": 2, "name": "ALLEN"}], "follow": true, "mode": 5}},
    {"name": "a new team keeps the favorite players", "start": {"players": [{"l": "nfl", "id": 3918298, "team": 2, "name": "ALLEN"}]}, "set": [["team", "mlb:15"]], "expect": {"players": [{"l": "nfl", "id": 3918298, "team": 2, "name": "ALLEN"}], "team": "mlb:15"}},

    {"name": "no known key answers 400", "start": {"rotate": 5}, "set": [["bogus", "1"]], "status": 400, "expect": {"rotate": 5}},
    {"name": "unknown keys next to known ones are skipped", "set": [["bogus", "1"], ["rotate", "5"]], "expect": {"rotate": 5}},
    {"name": "one refused key doesn't stop the rest", "set": [["mode", "9"], ["rotate", "5"], ["tz", "Mars"]], "expect": {"mode": 0, "rotate": 5, "tz": 1}},

    {"name": "idle display: the scores", "set": [["idle", "2"]], "expect": {"idle": 2}},
    {"name": "idle display: off or dim", "set": [["idle", "4"]], "expect": {"idle": 4}},
    {"name": "idle past the choices is refused", "start": {"idle": 1}, "set": [["idle", "5"]], "expect": {"idle": 1}},
    {"name": "a negative idle is refused", "start": {"idle": 3}, "set": [["idle", "-1"]], "expect": {"idle": 3}},
    {"name": "idle reads like atoi", "set": [["idle", "3x"]], "expect": {"idle": 3}},
    {"name": "idle as text is the next game", "start": {"idle": 2}, "set": [["idle", "clock"]], "expect": {"idle": 0}},
    {"name": "dim level in range", "set": [["idledim", "40"]], "expect": {"idledim": 40}},
    {"name": "dim level 0 is dark", "start": {"idledim": 40}, "set": [["idledim", "0"]], "expect": {"idledim": 0}},
    {"name": "dim level above 255 clamps down", "set": [["idledim", "999"]], "expect": {"idledim": 255}},
    {"name": "a negative dim level clamps up", "start": {"idledim": 40}, "set": [["idledim", "-5"]], "expect": {"idledim": 0}},
    {"name": "night hours on", "set": [["night", "1"]], "expect": {"night": true}},
    {"name": "night hours are on for 1 only", "start": {"night": true}, "set": [["night", "on"]], "expect": {"night": false}},
    {"name": "night start and end", "set": [["nightstart", "23:30"], ["nightend", "06:15"]], "expect": {"nightstart": "23:30", "nightend": "06:15"}},
    {"name": "a night time with one hour digit", "set": [["nightend", "6:00"]], "expect": {"nightend": "06:00"}},
    {"name": "a night time in minutes is refused", "set": [["nightstart", "1350"]], "expect": {"nightstart": "22:00"}},
    {"name": "a night time past the day is refused", "set": [["nightend", "24:00"]], "expect": {"nightend": "07:00"}},
    {"name": "a 12-hour night time is refused", "set": [["nightstart", "11:30 PM"]], "expect": {"nightstart": "22:00"}},
    {"name": "an empty night time is refused", "set": [["nightend", ""]], "expect": {"nightend": "07:00"}},
    {"name": "night brightness in range", "set": [["nightbri", "35"]], "expect": {"nightbri": 35}},
    {"name": "night brightness never goes dark", "set": [["nightbri", "0"]], "expect": {"nightbri": 1}},
    {"name": "night brightness above 255 clamps down", "set": [["nightbri", "400"]], "expect": {"nightbri": 255}},
    {"name": "the idle display and night hours in one request", "set": [["nightbri", "12"], ["night", "1"], ["idledim", "8"], ["idle", "4"]], "expect": {"idle": 4, "idledim": 8, "night": true, "nightbri": 12}},
    {"name": "the idle display keeps the follow pin", "start": {"mode": 5, "follow": true}, "set": [["idle", "1"], ["night", "1"]], "expect": {"follow": true, "idle": 1, "night": true}}
  ]
}
