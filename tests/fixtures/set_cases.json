    {"name": "switching to big plays in other games off", "set": [["watch", "0"]], "expect": {"watch": false}},
    {"name": "switching to big plays in other games back on", "start": {"watch": false}, "set": [["watch", "1"]], "expect": {"watch": true}},
    {"name": "switch from my team on", "set": [["watchmine", "1"]], "expect": {"watchmine": true}},
    {"name": "stay on a big play for two minutes", "set": [["watchstay", "120"]], "expect": {"watchstay": 120}},
    {"name": "a stay under 30 s clamps up", "start": {"watchstay": 120}, "set": [["watchstay", "10"]], "expect": {"watchstay": 30}},
    {"name": "a stay over 5 min clamps down", "set": [["watchstay", "600"]], "expect": {"watchstay": 300}},
    {"name": "a stay is kept in tens of seconds", "set": [["watchstay", "95"]], "expect": {"watchstay": 90}},
    {"name": "a stay with no number is the shortest", "set": [["watchstay", "abc"]], "expect": {"watchstay": 30}},
    {"name": "a stay past int's range clamps down, not around", "set": [["watchstay", "99999999999"]], "expect": {"watchstay": 300}},
    {"name": "follow during another game's big play follows the mode's game and goes back to it", "start": {"mode": 5, "visit": true}, "set": [["follow", "1"]], "expect": {"follow": true, "visit": false}},
    {"name": "follow with nothing to follow leaves another game's big play up", "start": {"mode": 0, "visit": true}, "set": [["follow", "1"]], "expect": {"follow": false, "visit": true}},
    {"name": "follow during another game's big play leaves it up when the mode's game has ended", "start": {"mode": 5, "visit": true, "final": true}, "set": [["follow", "1"]], "expect": {"follow": false, "visit": true}},
    {"name": "follow off leaves another game's big play up", "start": {"mode": 5, "visit": true}, "set": [["follow", "0"]], "expect": {"follow": false, "visit": true}},
    {"name": "turning off big plays in other games ends the one on the board", "start": {"mode": 5, "visit": true}, "set": [["watch", "0"]], "expect": {"watch": false, "visit": false}},
    {"name": "a new team ends another game's big play on the board", "start": {"visit": true}, "set": [["team", "mlb:15"]], "expect": {"visit": false, "team": "mlb:15"}},
    {"name": "the big-play settings leave Follow this game alone", "start": {"mode": 5, "follow": true}, "set": [["watch", "1"], ["watchstay", "120"], ["watchmine", "1"]], "expect": {"follow": true, "watchstay": 120, "watchmine": true}},

