    {"name": "follow on a game that has ended is ignored", "start": {"mode": 5, "final": true}, "set": [["follow", "1"]], "expect": {"follow": false}},
    {"name": "follow on a favorite's last final is ignored", "start": {"mode": 4, "favs": ["nfl:6", "", "", ""], "final": true}, "set": [["follow", "1"]], "expect": {"follow": false}},
    {"name": "follow 1 again on the final it follows keeps the pin", "start": {"mode": 5, "follow": true, "final": true}, "set": [["follow", "1"]], "expect": {"follow": true}},
    {"name": "an ignored follow doesn't stop the rest", "set": [["follow", "1"], ["rotate", "5"]], "expect": {"follow": false, "rotate": 5}},
