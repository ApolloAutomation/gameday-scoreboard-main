    {"name": "the 2x2", "set": [["panels", "2x2"]], "expect": {"panels": 2, "rows": 2, "wiring": 0}},
    {"name": "the 2x2 and its wiring in one request", "set": [["wiring", "1"], ["panels", "2x2"]], "expect": {"panels": 2, "rows": 2, "wiring": 1}},
    {"name": "back to one row from the 2x2", "start": {"panels": 2, "rows": 2}, "set": [["panels", "4"]], "expect": {"panels": 4, "rows": 1}},
    {"name": "one wide by two high is refused", "set": [["panels", "1x2"]], "expect": {"panels": 1, "rows": 1}},
    {"name": "a third row is refused", "start": {"panels": 3}, "set": [["panels", "2x3"]], "expect": {"panels": 3, "rows": 1}},
    {"name": "wide by one high is a row", "set": [["panels", "3x1"]], "expect": {"panels": 3, "rows": 1}},
    {"name": "a 2x2 with no rows after the x is refused", "start": {"panels": 2}, "set": [["panels", "2x"]], "expect": {"panels": 2, "rows": 1}},
    {"name": "the wiring is kept off a 2x2 too", "set": [["wiring", "2"]], "expect": {"wiring": 2, "panels": 1, "rows": 1}},
    {"name": "a wiring past the last is refused", "start": {"wiring": 1}, "set": [["wiring", "3"]], "expect": {"wiring": 1}},
    {"name": "a negative wiring is refused", "start": {"wiring": 2}, "set": [["wiring", "-1"]], "expect": {"wiring": 2}},
    {"name": "wiring reads like atoi, so text is folded under", "start": {"wiring": 2}, "set": [["wiring", "abc"]], "expect": {"wiring": 0}},

