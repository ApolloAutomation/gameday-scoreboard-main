    {"name": "four panels in a row", "set": [["panels", "4"]], "expect": {"panels": 4, "rows": 1}},
    {"name": "zero panels is refused", "start": {"panels": 2}, "set": [["panels", "0"]], "expect": {"panels": 2}},
    {"name": "more panels than the build drives is refused", "set": [["panels", "5"]], "expect": {"panels": 1, "rows": 1}},
    {"name": "a panel count past a byte is refused, not wrapped to one panel", "start": {"panels": 2}, "set": [["panels", "257"]], "expect": {"panels": 2}},
