    {"name": "new leagues let the pin go", "start": {"mode": 5, "follow": true}, "set": [["live", "mlb"]], "expect": {"follow": false}},
    {"name": "the same leagues keep the pin", "start": {"mode": 5, "follow": true}, "set": [["live", ""]], "expect": {"follow": true}},
